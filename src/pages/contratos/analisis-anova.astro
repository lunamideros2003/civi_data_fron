---
import CategoriaLayout from '../../layouts/CategoriaLayout.astro';
import { LucideInfo, LucideDatabase, LucideBarChart3, LucideTrendingUp, LucideAlertCircle, LucideCheckCircle, LucideXCircle } from 'lucide-react';

const hypotheses = [
	{
		id: 'departamento',
		num: 1,
		title: '¿El valor de contratos difiere entre departamentos?',
		h0: 'El valor promedio de contratos es igual en todos los departamentos de Colombia.',
		h1: 'Al menos un departamento tiene un valor promedio de contratos diferente.',
		dataset: 'Consolidado (SECOP I + II + Integrado)',
		nObs: '133,368',
		nGroups: 33,
		fStat: 525.48,
		pValue: '< 2.2e-16',
		decision: 'Rechazar H₀',
		significant: true,
		interpretation: 'Los departamentos difieren significativamente en el valor promedio de contratación. Esto sugiere desigualdad territorial en la inversión pública o diferencias en la capacidad de gasto.',
		effectSize: null,
		tukeyTotal: 45,
		tukeySig: 42,
	},
	{
		id: 'modalidad',
		num: 2,
		title: '¿El valor de contratos difiere según la modalidad de selección?',
		h0: 'El valor promedio es igual para todas las modalidades (Contratación Directa, Licitación Pública, Mínima Cuantía, etc.).',
		h1: 'Al menos una modalidad tiene un valor promedio diferente.',
		dataset: 'Consolidado (SECOP I + II + Integrado)',
		nObs: '133,325',
		nGroups: 29,
		fStat: 1381.18,
		pValue: '< 2.2e-16',
		decision: 'Rechazar H₀',
		significant: true,
		interpretation: 'La modalidad de selección está fuertemente asociada al monto: las licitaciones públicas manejan valores mucho mayores que la mínima cuantía, lo cual es coherente con el diseño normativo.',
		effectSize: null,
		tukeyTotal: 45,
		tukeySig: 39,
	},
	{
		id: 'tipo_contrato',
		num: 3,
		title: '¿El valor de contratos difiere según el tipo de contrato?',
		h0: 'El valor promedio es igual para todos los tipos de contrato (Obra, Consultoría, Suministro, etc.).',
		h1: 'Al menos un tipo de contrato tiene un valor promedio diferente.',
		dataset: 'Consolidado (SECOP I + II + Integrado)',
		nObs: '133,319',
		nGroups: 23,
		fStat: 2021.93,
		pValue: '< 2.2e-16',
		decision: 'Rechazar H₀',
		significant: true,
		interpretation: 'Los tipos de contrato tienen perfiles de valor muy distintos: obras e interventorías son significativamente más costosas que suministros o prestación de servicios.',
		effectSize: null,
		tukeyTotal: 45,
		tukeySig: 43,
	},
	{
		id: 'origen',
		num: 4,
		title: '¿El valor de contratos difiere entre fuentes SECOP (I vs II vs Integrado)?',
		h0: 'El valor promedio es igual entre SECOP I, SECOP II y SECOP Integrado.',
		h1: 'Al menos una fuente tiene un valor promedio diferente.',
		dataset: 'Consolidado (SECOP I + II + Integrado)',
		nObs: '133,371',
		nGroups: 3,
		fStat: 5114.58,
		pValue: '< 2.2e-16',
		decision: 'Rechazar H₀',
		significant: true,
		interpretation: 'Las fuentes capturan procesos con características distintas: SECOP II tiende a contratos de mayor valor que SECOP I, reflejando la migración gradual del sistema.',
		effectSize: null,
		tukeyTotal: 3,
		tukeySig: 3,
	},
	{
		id: 'sector',
		num: 5,
		title: '¿El valor de contratos difiere según el sector de gasto?',
		h0: 'El valor promedio es igual en todos los sectores (Educación, Salud, Transporte, Minas, etc.).',
		h1: 'Al menos un sector tiene un valor promedio diferente.',
		dataset: 'SECOP II',
		nObs: '48,306',
		nGroups: 24,
		fStat: 81.89,
		pValue: '< 2.2e-16',
		decision: 'Rechazar H₀',
		significant: true,
		interpretation: 'Los sectores de gasto público tienen perfiles de contratación distintos: Transporte y Minas manejan contratos de mayor valor que Educación o Deportes.',
		effectSize: null,
		tukeyTotal: 45,
		tukeySig: 38,
	},
	{
		id: 'modalidad_x_departamento',
		num: 6,
		title: '¿La modalidad afecta el valor de forma diferente según el departamento?',
		h0: 'No hay interacción entre modalidad y departamento: el efecto de la modalidad sobre el valor es el mismo en todos los departamentos.',
		h1: 'Existe interacción: el efecto de la modalidad sobre el valor varía según el departamento.',
		dataset: 'Consolidado (SECOP I + II + Integrado)',
		nObs: '132,857',
		nGroups: 479,
		fStat: 261.86,
		pValue: '< 2.2e-16',
		decision: 'Rechazar H₀',
		significant: true,
		interpretation: 'La modalidad tiene efectos diferentes según el departamento. Algunos departamentos usan modalidades de alto valor más que otros, revelando patrones regionales de contratación.',
		effectSize: 0.486,
		tukeyTotal: null,
		tukeySig: null,
	},
	{
		id: 'modalidad_x_tipo',
		num: 7,
		title: '¿La combinación modalidad × tipo de contrato afecta el valor?',
		h0: 'No hay interacción entre modalidad y tipo de contrato sobre el valor.',
		h1: 'La combinación de modalidad y tipo de contrato afecta el valor más allá de cada factor individual.',
		dataset: 'SECOP II',
		nObs: '48,262',
		nGroups: 53,
		fStat: 304.48,
		pValue: '< 2.2e-16',
		decision: 'Rechazar H₀',
		significant: true,
		interpretation: 'Ciertas modalidades se asocian preferentemente a tipos de contrato de mayor valor. Por ejemplo, Licitación Pública + Obra genera contratos mucho más costosos que Mínima Cuantía + Suministro.',
		effectSize: 0.251,
		tukeyTotal: null,
		tukeySig: null,
	},
];

const charts = {
	departamento: ['/anova/boxplot_departamento_consolidado.png', '/anova/bar_departamento_consolidado.png'],
	modalidad: ['/anova/boxplot_modalidad_consolidado.png', '/anova/bar_modalidad_consolidado.png'],
	tipo_contrato: ['/anova/boxplot_tipo_contrato_consolidado.png', '/anova/bar_tipo_contrato_consolidado.png'],
	origen: ['/anova/boxplot_origen_consolidado.png', '/anova/bar_origen_consolidado.png'],
	sector: ['/anova/boxplot_sector_secop2.png', '/anova/bar_sector_secop2.png'],
	modalidad_x_departamento: ['/anova/interaction_modalidad_departamen.png'],
	modalidad_x_tipo: ['/anova/interaction_modalidad__tipo_de_co.png'],
};
---

<CategoriaLayout 
	title="Análisis ANOVA" 
	category="Contratos"
>
	<!-- Intro -->
	<div class="mb-10">
		<div class="flex items-center gap-3 mb-4">
			<div class="px-3 py-1 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-brand-primary text-xs font-bold uppercase tracking-wider">
				Análisis Estadístico
			</div>
		</div>
		<h2 class="text-3xl font-heading font-bold mb-4">Análisis de Varianza (ANOVA)</h2>
		<p class="text-slate-400 text-lg leading-relaxed max-w-4xl">
			El análisis ANOVA determina si existen diferencias estadísticamente significativas en el valor promedio de contratos entre diferentes grupos categóricos. 
			Cada hipótesis compara si los valores son iguales (H₀) o si al menos un grupo difiere (H₁).
		</p>
		<div class="mt-6 flex flex-wrap gap-4">
			<div class="flex items-center gap-2 px-4 py-2 rounded-xl glass border border-white/10 text-sm">
				<LucideDatabase size={16} class="text-brand-primary" />
				<span class="text-slate-300">Consolidado: <strong class="text-white">133,371</strong> registros</span>
			</div>
			<div class="flex items-center gap-2 px-4 py-2 rounded-xl glass border border-white/10 text-sm">
				<LucideDatabase size={16} class="text-brand-primary" />
				<span class="text-slate-300">SECOP II: <strong class="text-white">48,310</strong> registros</span>
			</div>
			<div class="flex items-center gap-2 px-4 py-2 rounded-xl glass border border-white/10 text-sm">
				<LucideBarChart3 size={16} class="text-brand-primary" />
				<span class="text-slate-300">Variable: <strong class="text-white">log(1 + valor_contrato)</strong></span>
			</div>
		</div>
	</div>

	<!-- Summary Table -->
	<div class="mb-12 overflow-x-auto">
		<table class="w-full text-sm border-collapse">
			<thead>
				<tr class="border-b border-white/10">
					<th class="text-left py-3 px-4 text-slate-400 font-bold text-xs uppercase tracking-wider">#</th>
					<th class="text-left py-3 px-4 text-slate-400 font-bold text-xs uppercase tracking-wider">Hipótesis</th>
					<th class="text-left py-3 px-4 text-slate-400 font-bold text-xs uppercase tracking-wider">Dataset</th>
					<th class="text-left py-3 px-4 text-slate-400 font-bold text-xs uppercase tracking-wider">F</th>
					<th class="text-left py-3 px-4 text-slate-400 font-bold text-xs uppercase tracking-wider">p-value</th>
					<th class="text-left py-3 px-4 text-slate-400 font-bold text-xs uppercase tracking-wider">R²</th>
					<th class="text-left py-3 px-4 text-slate-400 font-bold text-xs uppercase tracking-wider">Decisión</th>
				</tr>
			</thead>
			<tbody>
				{hypotheses.map(h => (
					<tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
						<td class="py-3 px-4">
							<span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-brand-primary/20 text-brand-primary text-xs font-bold">{h.num}</span>
						</td>
						<td class="py-3 px-4 text-slate-200 font-medium max-w-xs">{h.title}</td>
						<td class="py-3 px-4 text-slate-500 text-xs">{h.dataset}</td>
						<td class="py-3 px-4 text-slate-300 font-mono">{h.fStat}</td>
						<td class="py-3 px-4 text-yellow-400 font-mono font-bold">{h.pValue}</td>
						<td class="py-3 px-4 text-slate-300 font-mono">{h.effectSize ? h.effectSize.toFixed(3) : '—'}</td>
						<td class="py-3 px-4">
							{h.significant ? (
								<span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-bold">
									<LucideXCircle size={12} /> Rechazar H₀
								</span>
							) : (
								<span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold">
									<LucideCheckCircle size={12} /> No rechazar H₀
								</span>
							)}
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>

	<!-- Detailed Cards -->
	<div class="space-y-12">
		{hypotheses.map(h => {
			const imgs = charts[h.id] || [];
			return (
				<div class="rounded-2xl glass border border-white/10 overflow-hidden" id={`hipotesis-${h.num}`}>
					<!-- Header -->
					<div class="p-6 md:p-8 border-b border-white/10">
						<div class="flex items-start justify-between gap-4 flex-wrap">
							<div class="flex items-center gap-3">
								<span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-brand-primary text-white text-lg font-bold">{h.num}</span>
								<h3 class="text-xl md:text-2xl font-heading font-bold">{h.title}</h3>
							</div>
							{h.significant ? (
								<span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-sm font-bold shrink-0">
									<LucideXCircle size={14} /> Se rechaza H₀
								</span>
							) : (
								<span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-bold shrink-0">
									<LucideCheckCircle size={14} /> No se rechaza H₀
								</span>
							)}
						</div>
						<div class="mt-3 flex items-center gap-2 text-xs text-slate-500">
							<LucideDatabase size={12} />
							<span>{h.dataset} · {h.nObs} observaciones · {h.nGroups} grupos</span>
						</div>
					</div>

					<!-- Body -->
					<div class="p-6 md:p-8">
						<!-- Hypotheses -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
							<div class="p-4 rounded-xl bg-red-500/5 border border-red-500/20 border-l-4 border-l-red-500">
								<p class="text-xs font-bold text-red-400 uppercase tracking-wider mb-1">H₀ (Nula)</p>
								<p class="text-sm text-slate-300">{h.h0}</p>
							</div>
							<div class="p-4 rounded-xl bg-brand-primary/5 border border-brand-primary/20 border-l-4 border-l-brand-primary">
								<p class="text-xs font-bold text-brand-primary uppercase tracking-wider mb-1">H₁ (Alternativa)</p>
								<p class="text-sm text-slate-300">{h.h1}</p>
							</div>
						</div>

						<!-- Stats -->
						<div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
							<div class="p-3 rounded-xl bg-white/5 border border-white/10 text-center">
								<p class="text-xs text-slate-500 uppercase">F</p>
								<p class="text-lg font-heading font-bold text-white">{h.fStat}</p>
							</div>
							<div class="p-3 rounded-xl bg-white/5 border border-white/10 text-center">
								<p class="text-xs text-slate-500 uppercase">p-value</p>
								<p class="text-lg font-heading font-bold text-yellow-400">{h.pValue}</p>
							</div>
							<div class="p-3 rounded-xl bg-white/5 border border-white/10 text-center">
								<p class="text-xs text-slate-500 uppercase">Decisión (α=0.05)</p>
								<p class="text-sm font-bold text-white">{h.decision}</p>
							</div>
							{h.effectSize && (
								<div class="p-3 rounded-xl bg-white/5 border border-white/10 text-center">
									<p class="text-xs text-slate-500 uppercase">R²</p>
									<p class="text-lg font-heading font-bold text-white">{h.effectSize.toFixed(3)}</p>
								</div>
							)}
							{h.tukeyTotal && (
								<div class="p-3 rounded-xl bg-white/5 border border-white/10 text-center">
									<p class="text-xs text-slate-500 uppercase">Tukey sig.</p>
									<p class="text-lg font-heading font-bold text-white">{h.tukeySig}/{h.tukeyTotal}</p>
								</div>
							)}
						</div>

						<!-- Interpretation -->
						<div class={`p-4 rounded-xl mb-6 ${h.significant ? 'bg-red-500/5 border border-red-500/20' : 'bg-emerald-500/5 border border-emerald-500/20'}`}>
							<div class="flex items-start gap-3">
								{h.significant ? <LucideAlertCircle size={20} class="text-red-400 shrink-0 mt-0.5" /> : <LucideCheckCircle size={20} class="text-emerald-400 shrink-0 mt-0.5" />}
								<div>
									<p class="text-sm font-bold text-slate-200 mb-1">Interpretación</p>
									<p class="text-sm text-slate-400 leading-relaxed">{h.interpretation}</p>
									{h.effectSize && (
										<p class="text-sm text-slate-400 mt-2">
											<strong class="text-white">R² = {h.effectSize.toFixed(3)}:</strong> el modelo explica {(h.effectSize * 100).toFixed(1)}% de la varianza en el valor de contratos.
										</p>
									)}
								</div>
							</div>
						</div>

						<!-- Charts -->
						{imgs.length > 0 && (
							<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
								{imgs.map(img => (
									<div class="rounded-xl overflow-hidden border border-white/10 bg-white/5">
										<img src={img} alt={img.split('/').pop()?.replace('.png', '').replace(/_/g, ' ')} class="w-full cursor-zoom-in hover:opacity-90 transition-opacity" loading="lazy" />
									</div>
								))}
							</div>
						)}
					</div>
				</div>
			);
		})}
	</div>

	<!-- Methodology Note -->
	<div class="mt-12 p-6 rounded-2xl glass border border-white/10">
		<div class="flex items-center gap-2 mb-4 text-brand-primary">
			<LucideInfo size={20} />
			<h3 class="font-bold">Nota Metodológica</h3>
		</div>
		<div class="space-y-3 text-sm text-slate-400">
			<p><strong class="text-slate-200">One-way ANOVA:</strong> scipy.stats.f_oneway — compara medias entre 3+ grupos independientes.</p>
			<p><strong class="text-slate-200">Two-way ANOVA:</strong> statsmodels OLS — evalúa efecto interactivo de dos factores sobre la variable dependiente.</p>
			<p><strong class="text-slate-200">Post-hoc:</strong> Tukey HSD (statsmodels) — identifica qué pares específicos de grupos difieren, controlando error por comparaciones múltiples.</p>
			<p><strong class="text-slate-200">Transformación:</strong> log(1 + valor_contrato) — comprime la escala para manejar valores desde ~$1M hasta ~$27B. Sin esta transformación, los gráficos serían ilegibles.</p>
			<p><strong class="text-slate-200">Nivel de significancia:</strong> α = 0.05</p>
			<p><strong class="text-slate-200">R² (Two-way):</strong> proporción de varianza explicada por el modelo. Más alto = diferencia más importante en la práctica.</p>
		</div>
	</div>
</CategoriaLayout>

<style>
	img {
		transition: transform 0.3s ease;
	}
	img:hover {
		transform: scale(1.02);
	}
</style>
